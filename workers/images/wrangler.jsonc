{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "factorio-prints-images",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-23",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"FIREBASE_PROJECT_ID": "facorio-blueprints",
		"LEGACY_R2_READS_ENABLED": "true",
		"UPLOADS_ENABLED": "false",
	},
	"workers_dev": false,
	"routes": [
		{
			"pattern": "images.factorioprints.com",
			"custom_domain": true,
		},
	],
	"r2_buckets": [
		{
			"binding": "IMAGES",
			"bucket_name": "factorio-prints-images",
		},
	],
	"analytics_engine_datasets": [
		{
			"binding": "IMAGE_GATEWAY_METRICS",
			"dataset": "factorio_prints_image_gateway",
		},
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
	},
	"env": {
		"preview": {
			"name": "factorio-prints-images-preview",
			"workers_dev": true,
			"routes": [],
			"vars": {
				"FIREBASE_PROJECT_ID": "facorio-blueprints",
				"LEGACY_R2_READS_ENABLED": "true",
				"UPLOADS_ENABLED": "false",
			},
			"r2_buckets": [
				{
					"binding": "IMAGES",
					"bucket_name": "factorio-prints-images",
				},
			],
			"analytics_engine_datasets": [
				{
					"binding": "IMAGE_GATEWAY_METRICS",
					"dataset": "factorio_prints_image_gateway_preview",
				},
			],
			"observability": {
				"enabled": true,
				"head_sampling_rate": 1,
			},
		},
	},
}
