{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "factorio-prints-images",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-23",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"FIREBASE_DATABASE_URL": "https://facorio-blueprints.firebaseio.com",
		"FIREBASE_PROJECT_ID": "facorio-blueprints",
		"LEGACY_R2_READS_ENABLED": "true",
		"UPLOAD_ALLOWED_ORIGINS": "https://factorioprints.com, https://www.factorioprints.com",
		"UPLOAD_HOURLY_LIMIT": "10",
	},
	"workers_dev": false,
	"routes": [
		{
			"pattern": "images.factorioprints.com",
			"custom_domain": true,
		},
	],
	"r2_buckets": [
		{
			"binding": "IMAGES",
			"bucket_name": "factorio-prints-images",
		},
	],
	"analytics_engine_datasets": [
		{
			"binding": "IMAGE_GATEWAY_METRICS",
			"dataset": "factorio_prints_image_gateway",
		},
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "IMGUR_UPLOADER",
				"class_name": "ImgurUploader",
			},
			{
				"name": "UPLOAD_QUOTA",
				"class_name": "UploadQuota",
			},
			{
				"name": "UPLOAD_EXPIRY",
				"class_name": "UploadExpiry",
			},
			{
				"name": "RECENT_IMAGE_COPIER",
				"class_name": "RecentImageCopier",
			},
		],
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["ImgurUploader"],
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["UploadQuota"],
		},
		{
			"tag": "v3",
			"new_sqlite_classes": ["UploadExpiry"],
		},
		{
			"tag": "v4",
			"new_sqlite_classes": ["RecentImageCopier"],
		},
	],
	// Copies images of recently saved blueprints into R2. Production only: preview shares the bucket.
	"triggers": {
		"crons": ["*/10 * * * *"],
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
	},
	"env": {
		"preview": {
			"name": "factorio-prints-images-preview",
			"triggers": {
				"crons": [],
			},
			"workers_dev": true,
			"routes": [],
			"vars": {
				"FIREBASE_DATABASE_URL": "https://facorio-blueprints.firebaseio.com",
				"FIREBASE_PROJECT_ID": "facorio-blueprints",
				"LEGACY_R2_READS_ENABLED": "true",
				"UPLOAD_ALLOWED_ORIGINS": "https://preview.factorio-prints.pages.dev, http://localhost:3000",
				"UPLOAD_HOURLY_LIMIT": "10",
			},
			"r2_buckets": [
				{
					"binding": "IMAGES",
					"bucket_name": "factorio-prints-images",
				},
			],
			"analytics_engine_datasets": [
				{
					"binding": "IMAGE_GATEWAY_METRICS",
					"dataset": "factorio_prints_image_gateway_preview",
				},
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "IMGUR_UPLOADER",
						"class_name": "ImgurUploader",
					},
					{
						"name": "UPLOAD_QUOTA",
						"class_name": "UploadQuota",
					},
					{
						"name": "UPLOAD_EXPIRY",
						"class_name": "UploadExpiry",
					},
					{
						"name": "RECENT_IMAGE_COPIER",
						"class_name": "RecentImageCopier",
					},
				],
			},
			"observability": {
				"enabled": true,
				"head_sampling_rate": 1,
			},
		},
	},
}
