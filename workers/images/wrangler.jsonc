{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "factorio-prints-images",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-23",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"FIREBASE_PROJECT_ID": "facorio-blueprints",
		"LEGACY_R2_READS_ENABLED": "true",
		"UPLOAD_ALLOWED_ORIGINS": "https://factorioprints.com, https://www.factorioprints.com",
		"UPLOAD_HOURLY_LIMIT": "10",
	},
	"workers_dev": false,
	"routes": [
		{
			"pattern": "images.factorioprints.com",
			"custom_domain": true,
		},
	],
	"r2_buckets": [
		{
			"binding": "IMAGES",
			"bucket_name": "factorio-prints-images",
		},
	],
	"analytics_engine_datasets": [
		{
			"binding": "IMAGE_GATEWAY_METRICS",
			"dataset": "factorio_prints_image_gateway",
		},
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "IMGUR_UPLOADER",
				"class_name": "ImgurUploader",
			},
			{
				"name": "UPLOAD_QUOTA",
				"class_name": "UploadQuota",
			},
		],
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["ImgurUploader"],
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["UploadQuota"],
		},
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
	},
	"env": {
		"preview": {
			"name": "factorio-prints-images-preview",
			"workers_dev": true,
			"routes": [],
			"vars": {
				"FIREBASE_PROJECT_ID": "facorio-blueprints",
				"LEGACY_R2_READS_ENABLED": "true",
				"UPLOAD_ALLOWED_ORIGINS": "https://preview.factorio-prints.pages.dev, http://localhost:3000",
				"UPLOAD_HOURLY_LIMIT": "10",
			},
			"r2_buckets": [
				{
					"binding": "IMAGES",
					"bucket_name": "factorio-prints-images",
				},
			],
			"analytics_engine_datasets": [
				{
					"binding": "IMAGE_GATEWAY_METRICS",
					"dataset": "factorio_prints_image_gateway_preview",
				},
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "IMGUR_UPLOADER",
						"class_name": "ImgurUploader",
					},
					{
						"name": "UPLOAD_QUOTA",
						"class_name": "UploadQuota",
					},
				],
			},
			"observability": {
				"enabled": true,
				"head_sampling_rate": 1,
			},
		},
	},
}
