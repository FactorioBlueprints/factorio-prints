/node_modules

# testing
/coverage

# production
/dist
/storybook-static

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local
JUSTFILE_BRANCH

npm-debug.log*
yarn-debug.log*
yarn-error.log*

.envrc
/.vite/

# Local documentation and context
.llm/
/.claude/*
