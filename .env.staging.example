# Staging Environment Configuration
# Copy this to .env.staging and update with your staging project values

# Firebase Staging Configuration
VITE_FIREBASE_API_KEY=your-staging-api-key
VITE_FIREBASE_AUTH_DOMAIN=factorio-blueprints-staging.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://factorio-blueprints-staging.firebaseio.com
VITE_FIREBASE_PROJECT_ID=factorio-blueprints-staging
VITE_FIREBASE_STORAGE_BUCKET=factorio-blueprints-staging.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-staging-sender-id
VITE_FIREBASE_APP_ID=your-staging-app-id

# Environment Indicator
VITE_ENVIRONMENT=staging

# Optional: Different Sentry DSN for staging
VITE_SENTRY_DSN=your-staging-sentry-dsn
