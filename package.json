{
	"name": "factorio-blueprints",
	"private": true,
	"version": "prod",
	"homepage": "https://factorioprints.com/",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"preview": "vite preview",
		"build": "npm run route:generate && tsc && vite build",
		"lint": "eslint . --fix",
		"format": "biome format --write . && prettier --write .",
		"ci:eslint": "eslint . --format json --output-file eslint_report.json",
		"ci:prettier": "prettier --check \"src/**/*.{js,ts,css,md,json}\"",
		"ci:biome": "biome format .",
		"ci:typecheck": "tsc --noEmit",
		"test": "vitest",
		"test:run": "vitest run",
		"route:generate": "tsr generate",
		"typecheck": "tsc --noEmit",
		"deploy:cloudflare": "wrangler pages deploy dist --project-name=factorio-prints",
		"deploy:cloudflare:preview": "wrangler pages deploy dist --project-name=factorio-prints --branch=preview",
		"deploy:cloudflare:production": "wrangler pages deploy dist --project-name=factorio-prints --branch=main",
		"deploy:functions": "cd functions && npm install && cd .. && firebase deploy --only functions",
		"deploy:all": "cd functions && npm install && cd .. && firebase deploy"
	},
	"dependencies": {
		"@fortawesome/fontawesome-svg-core": "7.0.1",
		"@fortawesome/free-brands-svg-icons": "7.0.1",
		"@fortawesome/free-regular-svg-icons": "7.0.1",
		"@fortawesome/free-solid-svg-icons": "7.0.1",
		"@fortawesome/react-fontawesome": "3.0.2",
		"@popperjs/core": "2.11.8",
		"@sentry/react": "10.11.0",
		"@tanstack/query-sync-storage-persister": "5.87.4",
		"@tanstack/react-form": "1.19.5",
		"@tanstack/react-query": "5.87.4",
		"@tanstack/react-query-persist-client": "5.87.4",
		"@tanstack/react-router": "1.131.37",
		"@tanstack/react-store": "0.7.5",
		"atob": "2.1.2",
		"axios": "1.11.0",
		"bootstrap": "5.3.8",
		"classnames": "2.5.1",
		"date-fns": "4.1.0",
		"disqus-react": "1.1.7",
		"dompurify": "3.2.6",
		"fflate": "0.8.2",
		"firebase": "12.2.1",
		"history": "5.3.0",
		"idb-keyval": "6.2.2",
		"immutability-helper": "3.1.1",
		"lodash": "4.17.21",
		"markdown-it": "14.1.0",
		"moment": "2.30.1",
		"prop-types": "15.8.1",
		"react": "19.1.1",
		"react-bootstrap": "2.10.10",
		"react-dom": "19.1.1",
		"react-firebase-hooks": "5.1.1",
		"react-select": "5.10.2",
		"usehooks-ts": "3.1.1",
		"zod": "4.1.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.4",
		"@eslint/js": "9.35.0",
		"@sentry/vite-plugin": "4.3.0",
		"@tanstack/react-query-devtools": "5.87.4",
		"@tanstack/router-cli": "1.131.37",
		"@tanstack/router-vite-plugin": "1.131.37",
		"@testing-library/dom": "10.4.1",
		"@testing-library/jest-dom": "6.8.0",
		"@testing-library/react": "16.3.0",
		"@types/atob": "2.1.4",
		"@types/lodash": "4.17.20",
		"@types/markdown-it": "14.1.2",
		"@types/node": "24.3.1",
		"@types/react": "19.1.12",
		"@types/react-dom": "19.1.9",
		"@types/serviceworker": "0.0.152",
		"@typescript-eslint/eslint-plugin": "8.43.0",
		"@typescript-eslint/parser": "8.43.0",
		"@vitejs/plugin-react": "5.0.2",
		"eslint": "9.35.0",
		"eslint-plugin-react": "7.37.5",
		"eslint-plugin-react-hooks": "5.2.0",
		"eslint-plugin-react-refresh": "0.4.20",
		"fake-indexeddb": "6.2.2",
		"globals": "16.4.0",
		"jiti": "2.5.1",
		"jsdom": "26.1.0",
		"less": "4.4.1",
		"prettier": "3.6.2",
		"typescript": "5.9.2",
		"vite": "7.1.5",
		"vitest": "3.2.4",
		"wrangler": "^4.35.0"
	}
}
