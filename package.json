{
	"name": "factorio-blueprints",
	"version": "prod",
	"private": true,
	"homepage": "https://factorioprints.com/",
	"type": "module",
	"scripts":
	{
		"preinstall": "npx only-allow pnpm",
		"dev": "vp dev",
		"preview": "vp preview",
		"check:toolchain": "node scripts/checkToolchainAlignment.ts",
		"check:blueprints": "WRANGLER_LOG_PATH=node_modules/.cache/wrangler/wrangler.log wrangler types workers/blueprints/worker-configuration.d.ts --config workers/blueprints/wrangler.jsonc && tsc --project workers/blueprints/tsconfig.json",
		"check:images": "WRANGLER_LOG_PATH=node_modules/.cache/wrangler/wrangler.log wrangler types workers/images/worker-configuration.d.ts --config workers/images/wrangler.jsonc && tsc --project workers/images/tsconfig.json",
		"blueprints:export-history": "node scripts/exportHistory.ts",
		"blueprints:import-history": "node scripts/importHistory.ts",
		"blueprints:load-d1": "node scripts/loadD1.ts",
		"blueprints:migrations": "drizzle-kit generate --config workers/blueprints/drizzle.config.ts",
		"blueprints:reconcile": "node scripts/reconcileD1.ts",
		"blueprints:test-migrations": "drizzle-kit generate --config workers/blueprints/drizzle.test.config.ts",
		"build": "vp run route:generate && tsc && vp build && VERIFY_SERVICE_WORKER_BUILD=true node node_modules/vitest/dist/cli.js run src/serviceWorkerTombstones.test.ts",
		"build:staging": "vp run route:generate && tsc && vp build --mode staging",
		"oxlint": "vp lint . --fix",
		"oxlint:ci": "vp lint . --format github",
		"fmt": "oxfmt-next-line",
		"fmt:ci": "oxfmt-next-line --check",
		"fallow": "fallow fix --yes --no-create-config",
		"fallow:ci": "fallow dead-code",
		"firebase:strip-author-display-names": "node scripts/stripAuthorDisplayNames.ts",
		"images:deploy:preview": "WRANGLER_LOG_PATH=node_modules/.cache/wrangler/images-preview.log wrangler deploy --config workers/images/wrangler.jsonc --env preview",
		"images:deploy:production": "WRANGLER_LOG_PATH=node_modules/.cache/wrangler/images-production.log wrangler deploy --config workers/images/wrangler.jsonc --env=\"\"",
		"images:dry-run:preview": "WRANGLER_LOG_PATH=node_modules/.cache/wrangler/images-preview-dry-run.log wrangler deploy --config workers/images/wrangler.jsonc --env preview --dry-run",
		"images:dry-run:production": "WRANGLER_LOG_PATH=node_modules/.cache/wrangler/images-production-dry-run.log wrangler deploy --config workers/images/wrangler.jsonc --env=\"\" --dry-run",
		"images:imgur-authorize": "node scripts/imgurAuthorize.ts",
		"images:replace": "node scripts/replaceImages.ts",
		"images:verify:preview": "node scripts/verifyImageGateway.ts \"$IMAGE_GATEWAY_PREVIEW_ORIGIN\"",
		"images:verify:production": "node scripts/verifyImageGateway.ts https://images.factorioprints.com",
		"test": "node node_modules/vitest/dist/cli.js",
		"test:ui": "node node_modules/vitest/dist/cli.js --ui",
		"test:database-rules": "firebase emulators:exec --only database \"node --test test/database.rules.emulator.mjs\"",
		"route:generate": "tsr generate",
		"typecheck": "tsc --noEmit",
		"verify:functions": "npm --prefix functions ci && npm --prefix functions run verify",
		"deploy:cloudflare": "wrangler pages deploy dist --project-name=factorio-prints",
		"deploy:cloudflare:preview": "wrangler pages deploy dist --project-name=factorio-prints --branch=preview",
		"deploy:cloudflare:production": "wrangler pages deploy dist --project-name=factorio-prints --branch=main",
		"deploy:functions": "firebase deploy --only functions",
		"deploy:all": "firebase deploy",
		"prepare": "VITE_GIT_HOOKS=0 vp config"
	},
	"dependencies":
	{
		"@fortawesome/fontawesome-svg-core": "7.3.1",
		"@fortawesome/free-brands-svg-icons": "7.3.1",
		"@fortawesome/free-regular-svg-icons": "7.3.1",
		"@fortawesome/free-solid-svg-icons": "7.3.1",
		"@fortawesome/react-fontawesome": "3.5.0",
		"@sentry/react": "11.10.0",
		"@tanstack/query-sync-storage-persister": "5.106.1",
		"@tanstack/react-form": "1.33.5",
		"@tanstack/react-query": "5.106.1",
		"@tanstack/react-query-devtools": "5.106.1",
		"@tanstack/react-query-persist-client": "5.106.1",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-store": "0.11.2",
		"bootswatch": "5.3.8",
		"date-fns": "4.4.0",
		"disqus-react": "1.1.7",
		"dompurify": "3.4.17",
		"drizzle-orm": "0.45.4",
		"fflate": "0.8.3",
		"firebase": "13.2.0",
		"idb-keyval": "6.3.0",
		"immutability-helper": "3.1.1",
		"lodash": "4.18.1",
		"markdown-it": "15.0.3",
		"moment": "2.31.0",
		"react": "19.3.1",
		"react-bootstrap": "2.10.10",
		"react-dom": "19.3.1",
		"react-firebase-hooks": "5.1.1",
		"react-select": "5.10.2",
		"zod": "4.6.7"
	},
	"devDependencies":
	{
		"@cloudflare/vitest-plugin": "1.4.7",
		"@firebase/rules-unit-testing": "6.0.0",
		"@sentry/vite-plugin": "11.10.0",
		"@tanstack/router-cli": "1.167.46",
		"@tanstack/router-vite-plugin": "1.167.48",
		"@testing-library/dom": "10.4.2",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@types/lodash": "4.17.27",
		"@types/markdown-it": "14.2.0",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.2.1",
		"drizzle-kit": "0.31.11",
		"fake-indexeddb": "6.2.7",
		"fallow": "3.39.0",
		"firebase-tools": "^15.35.0",
		"jsdom": "30.1.3",
		"markdownlint-cli2": "0.24.0",
		"playwright-core": "1.64.1",
		"typescript": "7.0.2",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:",
		"wrangler": "^4.158.0"
	},
	"packageManager": "pnpm@12.12.1"
}
