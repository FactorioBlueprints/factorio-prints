{
	"name": "factorio-blueprints",
	"private": true,
	"version": "prod",
	"homepage": "https://factorioprints.com/",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"preview": "vite preview",
		"build": "npm run route:generate && tsc && vite build",
		"lint": "eslint . --fix",
		"format": "biome format --write . && prettier --write .",
		"ci:eslint": "eslint . --format json --output-file eslint_report.json",
		"ci:prettier": "prettier --check \"src/**/*.{js,ts,css,md,json}\"",
		"ci:biome": "biome format .",
		"ci:typecheck": "tsc --noEmit",
		"test": "vitest",
		"test:run": "vitest run",
		"route:generate": "tsr generate",
		"typecheck": "tsc --noEmit",
		"deploy:cloudflare": "wrangler pages deploy dist --project-name=factorio-prints",
		"deploy:cloudflare:preview": "wrangler pages deploy dist --project-name=factorio-prints --branch=preview",
		"deploy:cloudflare:production": "wrangler pages deploy dist --project-name=factorio-prints --branch=main",
		"deploy:functions": "cd functions && npm install && cd .. && npx firebase deploy --only functions",
		"deploy:all": "cd functions && npm install && cd .. && npx firebase deploy"
	},
	"dependencies": {
		"@fortawesome/fontawesome-svg-core": "7.3.0",
		"@fortawesome/free-brands-svg-icons": "7.3.0",
		"@fortawesome/free-regular-svg-icons": "7.3.0",
		"@fortawesome/free-solid-svg-icons": "7.3.0",
		"@fortawesome/react-fontawesome": "3.5.0",
		"@popperjs/core": "2.11.8",
		"@sentry/react": "10.66.0",
		"@tanstack/query-sync-storage-persister": "5.100.1",
		"@tanstack/react-form": "1.29.1",
		"@tanstack/react-query": "5.100.1",
		"@tanstack/react-query-persist-client": "5.100.1",
		"@tanstack/react-router": "1.168.23",
		"@tanstack/react-store": "0.11.0",
		"atob": "2.1.2",
		"axios": "1.18.1",
		"bootstrap": "5.3.8",
		"classnames": "2.5.1",
		"date-fns": "4.4.0",
		"disqus-react": "1.1.7",
		"dompurify": "3.4.12",
		"fflate": "0.8.3",
		"firebase": "12.16.0",
		"history": "5.3.0",
		"idb-keyval": "6.3.0",
		"immutability-helper": "3.1.1",
		"lodash": "4.18.1",
		"markdown-it": "14.3.0",
		"moment": "2.30.1",
		"prop-types": "15.8.1",
		"react": "19.2.7",
		"react-bootstrap": "2.10.10",
		"react-dom": "19.2.7",
		"react-firebase-hooks": "5.1.1",
		"react-select": "5.10.2",
		"usehooks-ts": "3.1.1",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@eslint/js": "10.0.1",
		"@sentry/vite-plugin": "5.4.0",
		"@tanstack/react-query-devtools": "5.100.1",
		"@tanstack/router-cli": "1.166.34",
		"@tanstack/router-vite-plugin": "1.166.38",
		"@testing-library/dom": "10.4.1",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/react": "16.3.2",
		"@types/atob": "2.1.4",
		"@types/lodash": "4.17.24",
		"@types/markdown-it": "14.1.2",
		"@types/node": "26.1.1",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@types/serviceworker": "0.0.200",
		"@typescript-eslint/eslint-plugin": "8.57.1",
		"@typescript-eslint/parser": "8.57.1",
		"@vitejs/plugin-react": "6.0.3",
		"eslint": "10.7.0",
		"eslint-plugin-react-hooks": "7.1.1",
		"eslint-plugin-react-refresh": "0.5.3",
		"fake-indexeddb": "6.2.5",
		"firebase-tools": "^15.24.0",
		"globals": "17.7.0",
		"jiti": "2.7.0",
		"jsdom": "29.1.1",
		"less": "4.6.7",
		"prettier": "3.9.5",
		"typescript": "5.9.3",
		"vite": "8.1.5",
		"vitest": "4.1.10",
		"wrangler": "^4.112.0"
	}
}
