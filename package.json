{
  "name": "factorio-blueprints",
  "private": true,
  "version": "prod",
  "homepage": "https://factorioprints.com/",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vp dev",
    "preview": "vp preview",
    "build": "vp run route:generate && tsc && vp build && VERIFY_SERVICE_WORKER_BUILD=true node node_modules/vitest/dist/cli.js run src/serviceWorkerTombstones.test.ts",
    "lint": "vp lint . --fix",
    "format": "vp fmt --no-error-on-unmatched-pattern",
    "ci:eslint": "vp lint . --format json",
    "ci:prettier": "prettier --check \"src/**/*.{js,ts,css,md,json}\"",
    "ci:biome": "biome format .",
    "ci:typecheck": "tsc --noEmit",
    "test": "node node_modules/vitest/dist/cli.js",
    "test:run": "node node_modules/vitest/dist/cli.js run",
    "route:generate": "tsr generate",
    "typecheck": "tsc --noEmit",
    "deploy:cloudflare": "wrangler pages deploy dist --project-name=factorio-prints",
    "deploy:cloudflare:preview": "wrangler pages deploy dist --project-name=factorio-prints --branch=preview",
    "deploy:cloudflare:production": "wrangler pages deploy dist --project-name=factorio-prints --branch=main",
    "deploy:functions": "cd functions && npm install && cd .. && npx firebase deploy --only functions",
    "deploy:all": "cd functions && npm install && cd .. && npx firebase deploy",
    "prepare": "VITE_GIT_HOOKS=0 vp config"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "@fortawesome/free-regular-svg-icons": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/react-fontawesome": "3.5.0",
    "zod": "4.4.3",
    "usehooks-ts": "3.1.1",
    "react-select": "5.10.2",
    "@sentry/react": "10.68.0",
    "@tanstack/query-sync-storage-persister": "5.101.4",
    "@tanstack/react-form": "1.33.2",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-query-persist-client": "5.101.4",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-store": "0.11.0",
    "atob": "2.1.2",
    "react-firebase-hooks": "5.1.1",
    "react-dom": "19.2.8",
    "bootswatch": "5.3.8",
    "react-bootstrap": "2.10.10",
    "date-fns": "4.4.0",
    "disqus-react": "1.1.7",
    "dompurify": "3.4.12",
    "fflate": "0.8.3",
    "firebase": "12.16.0",
    "react": "19.2.8",
    "idb-keyval": "6.3.0",
    "immutability-helper": "3.1.1",
    "lodash": "4.18.1",
    "markdown-it": "14.3.0",
    "moment": "2.30.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@sentry/vite-plugin": "5.4.0",
    "@tanstack/react-query-devtools": "5.101.4",
    "@tanstack/router-cli": "1.167.21",
    "@tanstack/router-vite-plugin": "1.167.23",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/atob": "2.1.4",
    "@types/lodash": "4.17.24",
    "@types/markdown-it": "14.1.2",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/serviceworker": "0.0.200",
    "@vitejs/plugin-react": "6.0.4",
    "fake-indexeddb": "6.2.5",
    "fallow": "3.7.0",
    "firebase-tools": "^15.24.0",
    "vite-plus": "catalog:",
    "wrangler": "^4.115.0",
    "jsdom": "30.0.1",
    "less": "4.8.1",
    "vitest": "catalog:",
    "markdownlint-cli2": "0.23.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vite": "catalog:"
  },
  "packageManager": "pnpm@11.1.1"
}
