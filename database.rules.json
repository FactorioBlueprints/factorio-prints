{
	"rules": {
		"blueprints": {
			".read": "true",
			"$blueprint": {
				".write": "(!data.exists() && auth != null && newData.child('author').child('userId').val() === auth.uid) || (data.exists() && auth != null && data.child('author').child('userId').val() === auth.uid && newData.exists()) || (auth != null && root.child('moderators').child(auth.uid).val() === true)",
				".validate": "newData.hasChildren(['author'])",
				"author": {
					".validate": "newData.child('userId').isString()",
					"userId": {
						".validate": "newData.val() === auth.uid"
					}
				},
				"favorites": {
					"$uid": {
						".write": "auth != null && auth.uid == $uid",
						".validate": "newData.isBoolean()"
					}
				},
				"numberOfFavorites": {
					".write": "false",
					".validate": "(!data.exists() && newData.val() === 0) || (data.exists() && newData.val() === data.val())"
				}
			}
		},
		"users": {
			".read": "root.child('moderators').child(auth.uid).val() === true",
			"$uid": {
				".read": "auth != null && auth.uid == $uid",
				".write": "auth != null && auth.uid == $uid",
				"blueprints": {
					".read": "true",
					".write": "auth != null && (auth.uid == $uid || root.child('moderators').child(auth.uid).val() === true)",
					"$blueprintId": {
						".validate": "newData.isBoolean()"
					}
				},
				"collection": {
					".write": "auth != null && (auth.uid == $uid || root.child('moderators').child(auth.uid).val() === true)",
					"$blueprintId": {
						".validate": "newData.isBoolean()"
					}
				},
				"displayName": {
					".read": "true"
				}
			}
		},
		"moderators": {
			".read": "true",
			".write": "false"
		},
		"thumbnails": {
			".read": "true",
			"$blueprint": {
				".write": "auth != null && (root.child('blueprints').child($blueprint).child('author').child('userId').val() === auth.uid || root.child('moderators').child(auth.uid).val() === true)"
			}
		},
		"blueprintSummaries": {
			".read": "true",
			".indexOn": ["lastUpdatedDate", "authorId", "numberOfFavorites"],
			"$blueprint": {
				".write": "auth != null && (root.child('blueprints').child($blueprint).child('author').child('userId').val() === auth.uid || root.child('moderators').child(auth.uid).val() === true)",
				"numberOfFavorites": {
					".write": "false",
					".validate": "(!data.exists() && newData.val() === 0) || (data.exists() && newData.val() === data.val())"
				}
			}
		},
		"blueprintsPrivate": {
			".read": "false",
			"$blueprint": {
				".read": "auth != null && (root.child('blueprints').child($blueprint).child('authorId').val() === auth.uid || root.child('blueprints').child($blueprint).child('author').child('userId').val() === auth.uid || root.child('moderators').child(auth.uid).val() === true)",
				".write": "auth != null && (root.child('blueprints').child($blueprint).child('authorId').val() === auth.uid || root.child('blueprints').child($blueprint).child('author').child('userId').val() === auth.uid || root.child('moderators').child(auth.uid).val() === true)"
			}
		},
		"tags": {
			".read": "true",
			".indexOn": [".value"]
		},
		"byTag": {
			".read": "true",
			".write": "false",
			".indexOn": [".value"]
		}
	}
}
